{
  "expo": {
    "name": "Odontoplay",
    "slug": "odontoplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/shared/logo_odontoplay.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/shared/logo_odontoplay.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/shared/logo_odontoplay.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
